{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoPane",
  "version": "0.6.0",
  "identifier": "app.photopane.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhotoPane",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Lightweight image editor",
    "longDescription": "PhotoPane is a simple, modern image editor with layers, masks, editable text, adjustments, filters and PSD support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "psd"
        ],
        "name": "Photoshop document",
        "description": "Photoshop document",
        "role": "Editor",
        "mimeType": "image/vnd.adobe.photoshop"
      }
    ]
  }
}